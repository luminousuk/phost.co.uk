# Any address that isn't a real file goes to the home page.
# 302 (temporary) on purpose: browsers don't remember it, so real pages can be added later.
Options +SymLinksIfOwnerMatch -Indexes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^ / [R=302,L]

# Say UTF-8 in the Content-Type header too, not just in the page's <meta charset>.
AddDefaultCharset UTF-8
AddCharset UTF-8 .js .css .svg .webmanifest .xml

<IfModule mod_headers.c>
  # Built scripts and styles have a content hash in their names, and the fonts never change
  # (a new font gets a new file name), so both can be cached for good.
  <If "%{REQUEST_URI} =~ m#^/(assets|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Security headers. The page loads nothing from other sites, so the policy allows only its own
  # files. Styles set from script (the colour scheme) use the CSSOM, which this policy allows.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
